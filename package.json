{
  "name": "pdf-presenter",
  "version": "1.2.0",
  "description": "Professional Dual-Screen Presentation Software for Keynotes, Conferences and AV Teams with Bitfocus Companion API",
  "main": "main.js",
  "author": {
    "name": "Joseph Sharun",
    "url": "https://www.linkedin.com/in/joseph-sharun/"
  },
  "homepage": "https://github.com/SHARUNJOSEPH",
  "repository": {
    "type": "git",
    "url": "https://github.com/SHARUNJOSEPH/pdf-presenter"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/**/*.test.js",
    "test:e2e": "electron tests/e2e-automated-validation.js",
    "test:i18n:e2e": "electron tests/e2e-i18n-validation.js",
    "test:exhaustive": "electron tests/e2e-exhaustive-testing.js",
    "test:swarm": "electron tests/e2e-swarm-verification.js",
    "build:locales": "node scripts/build-locales.js",
    "verify": "node scripts/pre-flight-check.js",
    "web": "node server.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:appx": "electron-builder --win appx",
    "dist:mac": "electron-builder --mac",
    "dist:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.josephsharun.pdfpresenter",
    "productName": "PDF Presenter Suite",
    "copyright": "Copyright © 2026 Joseph Sharun",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "views/**/*",
      "css/**/*",
      "js/**/*",
      "locales/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "appx": {
      "applicationId": "PDFPresenterSuite",
      "identityName": "JOSEPHSHARUN.PDFPresenterSuite",
      "publisher": "CN=551A075B-7286-4B87-A119-02586E46BABD",
      "publisherDisplayName": "JOSEPH SHARUN",
      "displayName": "PDF Presenter Suite"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Presenter Suite",
      "languages": [
        "en_US",
        "es_ES",
        "fr_FR",
        "de_DE",
        "zh_CN",
        "ja_JP",
        "ar_SA",
        "pt_BR",
        "ru_RU",
        "it_IT"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  }
}
